<ol class='items-list'>
    <li class='item flexrow items-header'>
    <div class='item-name'>{{localize 'Name'}}</div>
    <div class='item-formula'></div><!-- Placeholder for the short description -->
    <div class='item-formula'>{{localize 'Purchased Rank'}}</div>
    <div class='item-formula'>{{localize 'Total Rank'}}</div>
    <div class='item-controls'>
      <a
        class='item-control item-create'
        title='{{localize "DOCUMENT.Create" type='power'}}'
        data-type='power'
      >
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type='power'}}
      </a>
    </div>
  </li>
    {{#each powers as |item id|}}
      <li class='item flexrow' data-item-id='{{item._id}}'>
        <div class='item-name flexrow'>
          <div class='item-image'>
            <a class='rollable' data-roll-type='power'><img
                src='{{item.img}}'
                title='{{item.name}}'
                width='24'
                height='24'
              /></a>
          </div>
          <h4>
              <input type="text" name="§items.{{item._id}}.name" value="{{item.name}}" data-dtype="String"/>
          </h4>
        </div>
        <div class='item-formula flexrow'>
            <small class="resource-label flexlarge align-center">({{item.system.shortDescription}})</small>
        </div>
        <div class='item-formula item-prop'>
          {{#if (isDefaultPower item)}}
            -
          {{else}}
            <input type="text" name="§items.{{item._id}}.system.rank" value="{{item.system.rank}}" data-dtype="Number"/>
          {{/if}}
        </div>
        <div class='item-formula item-prop no-left-border'>{{ifThen (isDefaultPower item) '-' (getDerivedPowerRank item._id)}}</div>
        <div class='item-controls'>
          <a
            class='item-control item-edit'
            title='{{localize "DOCUMENT.Update" type='power'}}'
          >
            <i class='fas fa-edit'></i>
          </a>
          <a
            class='item-control item-delete'
            title='{{localize "DOCUMENT.Delete" type='power'}}'
          >
            <i class='fas fa-trash'></i>
          </a>
        </div>
      </li>
    {{/each}}
</ol>