<div>
    <h3>Options</h3>
    <label class='resource-label'>Override Health (stops max health auto-updating)</label>
    <input type='checkbox' name='system.healthOverride' {{checked system.healthOverride}} />
    <br>
    <label class='resource-label'>Halve Health (for Foes)</label>
    <input type='checkbox' name='system.halveHealth' {{checked system.halveHealth}} />
    <br>
    <label class='resource-label'>Override Edge (stops edge auto-updating)</label>
    <input type='checkbox' name='system.edgeOverride' {{checked system.edgeOverride}} />
    <br>

    <!----------------------------------------------->
    <hr>
    <label class='resource-label'>Override Starting Resolve (stops starting resolve auto-updating)</label>
    <input type='checkbox' name='system.startingResolveOverride' {{checked system.startingResolveOverride}} />
    <br>
    {{#unless system.startingResolveOverride}}
        <label class='resource-label'>⤷Additional Resolve (From Flaws and the Determination Power)</label>
        <input type="text" name="system.resolveFromOtherSources" value="{{system.resolveFromOtherSources}}" data-dtype="Number" />
    {{/unless}}
    <br>

    <!----------------------------------------------->
    <hr>
    <label class='resource-label'>Hide Character Details in Rolls</label>
    <select name='system.hideActorDetails'>
        {{selectOptions hide_actor_details_choices selected=system.hideActorDetails}}
    </select>
    <br>

    <!----------------------------------------------->
    <hr>
    <label class='resource-label'>Override Hero Points(default is {{startingHeroPoints}})</label>
    <input type='checkbox' name='system.heroPointsOverride' {{checked system.heroPointsOverride}} />
    {{#if system.heroPointsOverride}}
        <br>
        <label class='resource-label'>⤷New Base Hero Points</label>
        <input type="text" name="system.baseHeroPoints" value="{{system.baseHeroPoints}}" data-dtype="Number" />
    {{/if}}
    <br>
    <!----------------------------------------------->
    <hr>
    <label class='resource-label'>Override Trait Cap(default is {{defaultTraitCap}})</label>
    <input type='checkbox' name='system.traitCapOverride' {{checked system.traitCapOverride}} />
    {{#if system.traitCapOverride}}
        <br>
        <label class='resource-label'>⤷New Trait Cap</label>
        <input type="text" name="system.traitCap" value="{{system.traitCap}}" data-dtype="Number" />
    {{/if}}
    <br>
</div>